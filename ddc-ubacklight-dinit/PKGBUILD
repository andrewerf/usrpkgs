pkgname=ddc-ubacklight-dinit
pkgver=20261008
pkgrel=1
pkgdesc='dinit service script for ddc-ubacklight'
arch=('any')
license=('GPL-2.0-only')
depends=('ddc-ubacklight' 'dinit')
provides=('init-ddc-ubacklight')
conflicts=('init-ddc-ubacklight')
source=('ddc-backlightd')
