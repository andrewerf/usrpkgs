# Maintainer: Antoine Damhet <antoine.damhet@lse.epita.fr>

pkgname=brightnessctl-git
_pkgname=brightnessctl
conflicts=('brightnessctl')
provides=('brightnessctl')
pkgver=0.5.1.r38.ge70bc55
pkgrel=1
pkgdesc="Lightweight brightness control tool"
arch=('x86_64')
url='https://github.com/Hummer12007/brightnessctl'
license=('MIT')
depends=('udev')
makedepends=('git')
source=(
  "git+https://github.com/Hummer12007/brightnessctl.git"
  "${_pkgname}.install"
)
sha512sums=('SKIP'
            '6491393c969d7116e273ce638a82d55dcc8000e00edff42d7b983a3ab588e6ba1a9dafeed59fa7e1daabd75327a856525f3d1eb42a0bc0f412252fff84817820')
install='brightnessctl.install'

pkgver() {
  cd "$_pkgname"
  git describe --long --tags --abbrev=7 | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "${_pkgname}"
  ./configure --prefix=/usr
  make UDEVDIR="/usr/lib/udev/rules.d" INSTALL_UDEV_RULES=1
}

package() {
  cd "${_pkgname}"
  make UDEVDIR="/usr/lib/udev/rules.d" INSTALL_UDEV_RULES=1 DESTDIR="$pkgdir" install

  mkdir -p "${pkgdir}/usr/share/licenses/${_pkgname}"
  install -m 0644 LICENSE "${pkgdir}/usr/share/licenses/${_pkgname}/"
}

# vim:set ts=2 sw=2 et:

